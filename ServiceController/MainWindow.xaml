<Window x:Class="ServiceController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApiPlayground · 服务控制器"
        Width="960" Height="680" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FA" Foreground="#22272B"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ControlTemplate x:Key="BtnTemplate" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F7"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#E8EEF1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="BtnPrimaryTemplate" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#314C59"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#2A414C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource BtnTemplate}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#3B5A6A"/>
            <Setter Property="BorderBrush" Value="#E2E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource BtnPrimaryTemplate}"/>
            <Setter Property="Background" Value="#3B5A6A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3B5A6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E7EB" BorderThickness="1"
                CornerRadius="6" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="20" Height="20"
                         Fill="#9AA5AB" VerticalAlignment="Center" Margin="0,0,14,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StateText" Text="启动中…" FontSize="20" FontWeight="Medium" Foreground="#22272B"/>
                    <TextBlock x:Name="MetaText" Text="正在读取主服务状态…" Foreground="#6B7780" Margin="0,4,0,0"/>
                    <TextBlock x:Name="CloseHintText" Text="× 关闭窗口 → 最小化到托盘，服务继续运行；托盘菜单「退出」才停止服务"
                               Foreground="#8A959C" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="24,0,0,0">
                    <TextBlock x:Name="PageLink" Text="调试页  http://127.0.0.1:5188/"
                               Foreground="#3B5A6A" Cursor="Hand" TextDecorations="Underline"
                               HorizontalAlignment="Right" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ApiLink" Text="主服务  http://127.0.0.1:5180/"
                               Foreground="#3B5A6A" Cursor="Hand" TextDecorations="Underline"
                               HorizontalAlignment="Right" Margin="0,0,0,6"/>
                    <TextBlock x:Name="LogFileText" Text="日志  controller.log"
                               Foreground="#8A959C" FontSize="11" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnStart" Content="启动服务" Style="{StaticResource BtnPrimary}"/>
            <Button x:Name="BtnStop" Content="停止服务" Style="{StaticResource Btn}"/>
            <Button x:Name="BtnBuild" Content="重新编译" Style="{StaticResource Btn}"/>
            <Button x:Name="BtnOpen" Content="打开页面" Style="{StaticResource Btn}"/>
            <Button x:Name="BtnLog" Content="查看日志" Style="{StaticResource Btn}"/>
            <Button x:Name="BtnFolder" Content="日志目录" Style="{StaticResource Btn}"/>
            <Button x:Name="BtnClear" Content="清空" Style="{StaticResource Btn}"/>
            <Button x:Name="BtnCopy" Content="复制" Style="{StaticResource Btn}"/>
            <Button x:Name="BtnSettings" Content="设置" Style="{StaticResource Btn}"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="实时日志" FontWeight="Medium" VerticalAlignment="Center"/>
            <TextBlock Text="偏好与关闭行为请点「设置」"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="#8A959C" FontSize="11"/>
        </Grid>

        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E7EB" BorderThickness="1"
                CornerRadius="6" Padding="1">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Foreground="#22272B"
                     Background="Transparent" BorderThickness="0" Padding="10"
                     IsTabStop="False" UndoLimit="0"/>
        </Border>

        <TextBlock x:Name="FooterText" Grid.Row="4" Margin="0,10,0,0"
                   FontSize="11" Foreground="#8A959C" TextTrimming="CharacterEllipsis"
                   Text="日志文件  -    ｜    主服务输出已精简（只留请求结果与告警）    ｜    右键托盘图标可退出"/>
    </Grid>
</Window>
