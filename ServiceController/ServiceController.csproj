<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows 目标框架：托盘图标来自 WinForms（Microsoft.WindowsDesktop.App，框架自带，零 NuGet） -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- WinExe：双击不出黑窗口。要命令行的场景传 console 开关（运行时 AllocConsole 再挂一个） -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ServiceController</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 允许在 Linux / macOS 上交叉发布 win-x64（publish.sh 用得到）；Windows 上无副作用 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
